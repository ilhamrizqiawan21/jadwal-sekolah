/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  "appId": "com.jadwalpendidikan.app",
  "productName": "Jadwal Pendidikan",
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "files": [
    "out/**/*"
  ],
  "win": {
    "executableName": "JadwalPendidikan",
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Jadwal Pendidikan",
    "uninstallDisplayName": "Jadwal Pendidikan",
    "installerLanguages": ["id", "en"]
  }
}
