/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  "appId": "com.jadwalsekolah.app",
  "productName": "Jadwal Sekolah",
  "copyright": "Jadwal Sekolah",
  "directories": {
    "buildResources": "resources",
    "output": "release"
  },
  "files": [
    "out/**/*",
    "!**/*.map"
  ],
  "asar": true,
  "fileAssociations": [
    {
      "ext": "jadwal",
      "name": "Berkas Jadwal Sekolah",
      "description": "Berkas Jadwal Sekolah",
      "role": "Editor"
    }
  ],
  "win": {
    "executableName": "JadwalSekolah",
    "icon": "resources/icon.png",
    "requestedExecutionLevel": "asInvoker",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "JadwalSekolah-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "JadwalSekolah-Portable-${version}.${ext}"
  }
}
